---
import { Image } from 'astro:assets';
import { services } from '@/data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout title={service.title} description={service.description} image={service.image.src}>
  <Header slot="header" />

  <main class="mx-auto max-w-7xl px-6 py-12 md:py-20">
    <div class="mb-10">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Services', href: '/#services' },
          { label: service.title },
        ]}
      />
    </div>

    <article class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10">
          <service.Icon className="w-9 text-primary" />
        </div>
        <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">{service.title}</h1>
        <p class="mt-6 text-lg leading-relaxed text-foreground/70">{service.description}</p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-lg bg-primary px-5 py-3 font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Discuss your project
        </a>
      </div>

      <Image
        src={service.image}
        alt={service.title}
        class="w-full rounded-3xl border object-cover shadow-lg"
      />
    </article>
  </main>

  <Footer slot="footer" />
</BaseLayout>
