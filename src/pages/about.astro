---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout title="About Us" description="Learn more about ILIKS and the team behind it.">
  <Header slot="header" />

  <main class="mx-auto max-w-4xl px-6 py-20 md:py-32">
    <header class="text-center md:mb-16">
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-primary sm:text-5xl">
        About Us
      </h1>
      <p class="mt-6 text-lg text-foreground/70">
        Building the ultimate open-source SEO theme for Astro.
      </p>
    </header>

    <div class="prose prose-zinc prose-lg mx-auto dark:prose-invert">
      <h2>Our Mission</h2>
      <p>
        We believe that technical SEO shouldn't be an afterthought. It should be baked into the
        foundation of every marketing website. That's why we created ILIKS—to provide a
        robust, lightning-fast starting point for B2B SaaS companies.
      </p>
      <h2>Our Vission</h2>
      <p>
        We envision a world where every website is optimized for search engines from the ground up,
        ensuring that businesses can reach their target audience effectively and efficiently. Our
        goal is to empower developers and marketers alike to create websites that not only look
        great but also perform exceptionally well in search rankings.
      </p>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
