---
/**
 * LanguagePicker.astro — Accessible language switcher dropdown.
 * Renders a native <select> styled to match the design system.
 * Zero JavaScript overhead (just a native form element).
 */
import { languages, type Lang } from '../../i18n/ui';
import { getLangFromUrl, getAlternateLocales } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const alternates = getAlternateLocales(Astro.url.pathname);
---

<div class="relative">
  <label for="language-select" class="sr-only">
    Select language
  </label>
  <select
    id="language-select"
    class="cursor-pointer appearance-none rounded-lg border border-foreground/20 px-2 py-1 pr-6 text-sm font-medium transition-colors hover:text-primary focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary md:px-3 md:py-1.5 md:pr-8"
  >
    {alternates.map(({ lang, href }) => (
      <option value={href} selected={lang === currentLang}>
        {lang.toUpperCase()}
      </option>
    ))}
  </select>
  <!-- Dropdown arrow -->
  <svg
    class="pointer-events-none absolute right-2 top-1/2 h-4 w-4 -translate-y-1/2"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
  </svg>
</div>

<script>
  const select = document.getElementById('language-select') as HTMLSelectElement | null;
  select?.addEventListener('change', () => {
    window.location.pathname = select.value;
  });
</script>
