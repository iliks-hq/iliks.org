---
import { ArrowUpRightIcon } from 'lucide-react';
import { ButtonLink } from '../ui/button-link';
import type { Service } from '@/data/services';

/**
 * BentoGrid.astro — Feature Highlights Grid
 *
 * A modern, CSS grid-based layout for highlighting key features.
 * Features span different rows/cols to create an asymmetric, "bento box" look.
 */

interface BentoItem extends Service {
  colSpan?: 1 | 2; // Span 1 or 2 columns
  rowSpan?: 1 | 2; // Span 1 or 2 rows
}

interface Props {
  id: 'services' | 'features';
  title: string;
  subtitle?: string;
  items: BentoItem[];
}

const { title, subtitle, items, id } = Astro.props;
---

<section id={id} class="py-20 md:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-primary text-3xl font-bold tracking-tight sm:text-4xl">
        {title}
      </h2>
      {subtitle && <p class="mt-4 text-lg">{subtitle}</p>}
    </div>

    <div class="mx-auto mt-16 grid max-w-7xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <div
          class:list={[
            'group relative flex flex-col items-center overflow-hidden rounded-3xl border p-8 transition-all duration-300 hover:border-primary hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/5 dark:hover:shadow-primary/10',
            item.colSpan === 2 && 'sm:col-span-2',
            item.rowSpan === 2 && 'sm:row-span-2',
          ]}
        >
          <ButtonLink
            variant={'link'}
            href={`/services/${item.id}`}
            className="absolute z-20 top-5 right-5 md:opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <ArrowUpRightIcon />
            Learn more
          </ButtonLink>
          <div class="relative z-10">
            {item.Icon && (
              <div class="mb-6 inline-flex h-12 w-12 justify-center items-center rounded-xl dark:bg-primary/10">
                <item.Icon className="w-full text-primary" />
              </div>
            )}
            <h3 class="text-xl font-semibold">{item.title}</h3>
            <p class="mt-3 text-foreground/70 leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
