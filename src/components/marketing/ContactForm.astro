---
/**
 * ContactForm.astro
 * Native HTML form styled with Tailwind.
 * Ready for Web3Forms or Formspree. Just add your access key.
 */

import { ArrowUpRightIcon } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { Button } from '@/components/ui/button';
import { Field, FieldLabel } from '@/components/ui/field';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Web3Forms access key
const ACCESS_KEY = import.meta.env.WEB3FORMS_ACCESS_KEY;
---

<form id="contact-form" class="space-y-6">
  <input type="hidden" name="access_key" value={ACCESS_KEY} />
  <!-- Honey pot to prevent spam -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

  <div class="grid gap-6 sm:grid-cols-2">
    <Field>
      <FieldLabel aria-label="First Name" className="text-primary">
        {t('contact.firstName')}
      </FieldLabel>
      <Input className="border-primary/30" type="text" name="First Name" id="first-name" required />
    </Field>
    <Field>
      <FieldLabel aria-label="Last Name" className="text-primary">
        {t('contact.lastName')}
      </FieldLabel>
      <Input className="border-primary/30" type="text" name="Last Name" id="last-name" required />
    </Field>
  </div>

  <Field>
    <FieldLabel aria-label="Email" className="text-primary">
      {t('contact.email')}
    </FieldLabel>
    <Input className="border-primary/30" type="email" name="email" id="email" required />
  </Field>

  <Field>
    <FieldLabel aria-label="Message" className="text-primary">
      {t('contact.message')}
    </FieldLabel>
    <Textarea className="border-primary/30 h-24" id="message" name="message" required />
  </Field>

  <Button id="contact-form-submit-button" size="lg" className="w-full" type="submit">
    {t('contact.submit')} <ArrowUpRightIcon className="size-5 mt-0.5" />
  </Button>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitButton = document.getElementById('contact-form-submit-button') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitButton.setAttribute('disabled', 'true');
    submitButton.innerHTML = 'Sending...';

    const formData = new FormData(form);

    const firstName = String(formData.get('first-name') ?? '').trim();
    const lastName = String(formData.get('last-name') ?? '').trim();
    const email = String(formData.get('email') ?? '').trim();

    const name = [firstName, lastName].filter(Boolean).join(' ');

    formData.set('subject', `New Inquiry from ${name || email}`);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });

      const data = await response.json();

      if (response.ok && data.success) {
        submitButton.innerHTML = 'Message Sent Successfully!';

        form.reset();
      } else {
        throw new Error(data.message || 'Failed to submit the form.');
      }
    } catch {
      submitButton.innerHTML = 'Try Again';
      submitButton.classList.add('bg-red-500', 'text-white');
    } finally {
      submitButton.removeAttribute('disabled');
      submitButton.innerHTML = 'Submit Another Message';
      submitButton.classList.remove('bg-red-500', 'text-white');
    }
  });
</script>
